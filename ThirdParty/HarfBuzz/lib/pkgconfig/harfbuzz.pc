prefix=C:/Program Files/harfbuzz
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: harfbuzz
Description: HarfBuzz text shaping library
Version: 14.2.1

Libs: -L${libdir} -lharfbuzz
Libs.private: -lm 
Requires.private: freetype2 >= 20.0.14
Cflags: -I${includedir}/harfbuzz
